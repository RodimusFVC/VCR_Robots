set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008

set_global_assignment -name SYSTEMVERILOG_FILE VCR-Robots.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/Robots.sv

# STRIP-2026-08-15: the Dragon's Lair control layer was removed, not renamed.
# Robots has no arcade PCB -- no Z80, no AY-3-8910, no LD-V1000, no NVRAM -- so
# rtl/DragonsLair{,_CPU,_LDV1000}.sv, rtl/cpu/T80/, rtl/sound/ (jt49+Filters) and
# rtl/nvram.v were deleted along with their assignments here.  What the fork was
# FOR is everything under rtl/video/ below, plus ddram/pll/sys.  rtl/Robots.sv
# replaces the deleted control layer on the same 5-signal seam
# (ld_frame_o / ld_search_cmd_o / ld_playing_o / led_digits_o / dbg_led).

set_global_assignment -name VERILOG_FILE rtl/pause.v

set_global_assignment -name VHDL_FILE rtl/ram_rom/dpram_dc.vhd
set_global_assignment -name VHDL_FILE rtl/ram_rom/spram.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ram_rom/rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ram_rom/ddram.sv

set_global_assignment -name VERILOG_FILE rtl/pll.v
set_global_assignment -name VERILOG_FILE rtl/pll/pll_0002.v

# --- In-fabric MJPEG video: ultraembedded/core_jpeg (Apache-2.0) + wrapper ---
set_global_assignment -name VERILOG_FILE rtl/video/jpeg_frame_decoder.v
set_global_assignment -name VERILOG_FILE rtl/video/dlv_streamer.v
